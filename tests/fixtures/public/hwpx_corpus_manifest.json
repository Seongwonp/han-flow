{
  "schemaVersion": 1,
  "suite": "han-flow-public-hwpx",
  "fixtures": [
    {
      "id": "baseline",
      "category": "document-baseline",
      "generator": "createSyntheticHwpx",
      "options": { "fileName": "baseline.hwpx" },
      "expected": { "outcome": "opened", "sections": 2, "tables": 1, "cells": 4, "resources": 1, "estimatedPages": 3 }
    },
    {
      "id": "cell-continuation",
      "category": "table-pagination",
      "generator": "createCellFragmentHwpx",
      "fileName": "cell-continuation.hwpx",
      "expected": { "outcome": "opened", "sections": 1, "tables": 2, "cells": 3, "resources": 0, "estimatedPages": 3 }
    },
    {
      "id": "images-rowspan",
      "category": "images-and-span",
      "generator": "createCompatibilityHwpx",
      "fileName": "images-rowspan.hwpx",
      "expected": { "outcome": "opened", "sections": 1, "tables": 1, "cells": 5, "resources": 12, "estimatedPages": 1 }
    },
    {
      "id": "table-columns",
      "category": "table-structure",
      "generator": "createTableColumnHwpx",
      "fileName": "table-columns.hwpx",
      "expected": { "outcome": "opened", "sections": 1, "tables": 1, "cells": 9, "resources": 0, "estimatedPages": 1 }
    },
    {
      "id": "list-markers",
      "category": "lists-and-numbering",
      "generator": "createListMarkerHwpx",
      "fileName": "list-markers.hwpx",
      "expected": {
        "outcome": "opened",
        "sections": 1,
        "tables": 0,
        "cells": 0,
        "resources": 0,
        "markedParagraphs": 4,
        "bulletParagraphs": 2,
        "numberedParagraphs": 2,
        "estimatedPages": 1
      }
    },
    {
      "id": "multi-column-layout",
      "category": "multi-column-layout",
      "generator": "createMultiColumnHwpx",
      "fileName": "multi-column-layout.hwpx",
      "expected": {
        "outcome": "opened",
        "sections": 1,
        "tables": 0,
        "cells": 0,
        "resources": 0,
        "diagnostics": 1,
        "multiColumnSections": 1,
        "declaredColumns": 2,
        "estimatedPages": 1
      }
    },
    {
      "id": "round-trip-sentinels",
      "category": "package-preservation",
      "generator": "createRoundTripHwpx",
      "fileName": "round-trip-sentinels.hwpx",
      "expected": { "outcome": "opened", "sections": 1, "tables": 1, "cells": 4, "resources": 1, "estimatedPages": 2 }
    },
    {
      "id": "large-progressive",
      "category": "large-document",
      "generator": "createSyntheticHwpx",
      "options": {
        "fileName": "large-progressive.hwpx",
        "sectionCount": 80,
        "paragraphsPerExtraSection": 250,
        "imageBytes": 5242880
      },
      "expected": { "outcome": "opened", "sections": 80, "tables": 1, "cells": 4, "resources": 1, "minimumEstimatedPages": 50 }
    },
    {
      "id": "invalid-package",
      "category": "invalid-package",
      "generator": "createInvalidHwpx",
      "fileName": "invalid-package.hwpx",
      "expected": { "outcome": "rejected", "errorCode": "HWPX_IMPORT_FAILED" }
    }
  ]
}
