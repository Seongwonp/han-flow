{
  "name": "han-flow",
  "version": "0.1.0",
  "description": "빠르고 가벼운 macOS용 읽기 전용 HWPX 뷰어",
  "author": "Seongwon Park",
  "main": "./out/main/index.js",
  "build": {
    "appId": "com.hanflow.viewer",
    "productName": "Han-Flow",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": ["out/**/*", "package.json"],
    "fileAssociations": [
      {
        "ext": "hwpx",
        "name": "HWPX 문서",
        "description": "한글 개방형 문서",
        "role": "Viewer",
        "mimeType": "application/hwp+zip",
        "rank": "Alternate"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "identity": null,
      "target": ["dir"],
      "extendInfo": {
        "CFBundleDisplayName": "Han-Flow",
        "UTExportedTypeDeclarations": [
          {
            "UTTypeIdentifier": "com.hanflow.hwpx",
            "UTTypeDescription": "HWPX 문서",
            "UTTypeConformsTo": ["public.data", "public.archive"],
            "UTTypeTagSpecification": {
              "public.filename-extension": ["hwpx"],
              "public.mime-type": "application/hwp+zip"
            }
          }
        ]
      }
    }
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "package:mac": "npm run build && electron-builder --mac dir",
    "preview": "electron-vite preview",
    "test": "jest",
    "benchmark:decoder": "HAN_FLOW_BENCHMARK=1 jest --runInBand tests/performance/decoder_benchmark.test.ts"
  },
  "dependencies": {
    "@types/katex": "^0.16.8",
    "adm-zip": "^0.5.17",
    "cfb": "^1.2.2",
    "electron-updater": "^6.1.7",
    "fast-xml-parser": "^4.3.2",
    "font-list": "^2.1.0",
    "katex": "^0.17.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^5.6.0",
    "unzipper": "^0.10.14",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^2.0.0",
    "@electron-toolkit/eslint-config-ts": "^1.0.1",
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@electron-toolkit/utils": "^3.0.0",
    "@types/adm-zip": "^0.5.8",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.4",
    "@types/react": "^18.2.42",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^28.1.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^2.3.0",
    "eslint": "^8.55.0",
    "jest": "^29.7.0",
    "prettier": "^3.1.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.3",
    "vite": "^5.0.7"
  }
}
